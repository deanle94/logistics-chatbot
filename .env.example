# Copy to .env and override for anything that is not a local throwaway.
#
# docker-compose.yml declares the same values as defaults, so `docker compose up`
# works with no .env at all. That is a deliberate trade-off: a one-command start is
# an acceptance criterion (S0.5), and these credentials only ever reach a local
# container. Any non-local deployment MUST override every value here.

# --- PostgreSQL superuser (container bootstrap only) -----------------------------
POSTGRES_DB=logistics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev

# --- Owning role: used ONLY by the one-shot seeder --------------------------------
APP_OWNER_USER=app_owner
APP_OWNER_PASSWORD=app_owner_local_dev

# --- Read-only role: what the API connects as -------------------------------------
APP_RO_USER=app_ro
APP_RO_PASSWORD=app_ro_local_dev

# --- Published ports ---------------------------------------------------------------
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- LLM provider (Slice 2) ---------------------------------------------------------
# The one value that selects a provider. `init_chat_model` parses the "provider:model"
# form, so switching provider is this line plus the matching langchain-* dependency.
# Pinned to a dated model id, never an alias: an alias can be repointed underneath a
# recorded gate (decision-log D24).
LLM_MODEL=anthropic:claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=25

# Your key. Leave EMPTY here - .env.example is committed, .env is not (.gitignore line 2).
# `uv run pytest -m stack` needs a funded key and makes real, billable calls; the default
# `uv run pytest` gate needs none and never reaches the network.
ANTHROPIC_API_KEY=

# --- LangSmith tracing (optional) ---------------------------------------------------
# Env vars only, zero code: langchain auto-traces every run when LANGSMITH_TRACING=true.
# Leave the key EMPTY here for the same reason as ANTHROPIC_API_KEY above.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dean-demo
