# Copy to .env and override for anything that is not a local throwaway.
#
# docker-compose.yml declares the same values as defaults, so `docker compose up`
# works with no .env at all. That is a deliberate trade-off: a one-command start is
# an acceptance criterion (S0.5), and these credentials only ever reach a local
# container. Any non-local deployment MUST override every value here.

# --- PostgreSQL superuser (container bootstrap only) -----------------------------
POSTGRES_DB=logistics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev

# --- Owning role: used ONLY by the one-shot seeder --------------------------------
APP_OWNER_USER=app_owner
APP_OWNER_PASSWORD=app_owner_local_dev

# --- Read-only role: what the API connects as -------------------------------------
APP_RO_USER=app_ro
APP_RO_PASSWORD=app_ro_local_dev

# --- Published ports ---------------------------------------------------------------
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
